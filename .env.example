# Configuration overrides for LMS Polinema MCP
# All settings can be overridden via environment variables with prefix LMS_POLINEMA_

LMS_POLINEMA_INSTITUTION_NAME=Polinema
LMS_POLINEMA_INSTITUTION_FULL_NAME=Politeknik Negeri Malang

LMS_POLINEMA_SIAKAD_BASE_URL=https://siakad.polinema.ac.id
LMS_POLINEMA_SIAKAD_LMS_PATH=/mahasiswa/slc/index/gm/akademik

LMS_POLINEMA_SPADA_BASE_URL=https://slc.polinema.ac.id/spada
LMS_POLINEMA_MOODLE_BASE_URL=https://lmsslc.polinema.ac.id

# Network timeouts and caching (seconds)
LMS_POLINEMA_HTTP_TIMEOUT=20.0
LMS_POLINEMA_COURSE_CACHE_TTL_SECONDS=1800
LMS_POLINEMA_SESSION_CACHE_TTL_SECONDS=300
